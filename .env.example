# Copy to .env and fill in. Never commit the filled file.

# Neon Postgres. DATABASE_URL is the pooled host used by the app; DIRECT_URL is
# the same database without "-pooler", used by prisma migrate.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=verify-full"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?channel_binding=require&sslmode=verify-full"

# Encrypts the NextAuth session cookie. Rotating it logs everyone out.
#   npx auth secret
AUTH_SECRET=""

# Cloudflare R2 — photographs uploaded from the dashboard.
# The S3 API endpoint is derived from the account id; R2_PUBLIC_URL is the
# custom domain the bucket is served on, and is what ends up in <img src>.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://cdn.example.com"

# Resend — booking notifications (not wired up yet)
RESEND_API_KEY=""
