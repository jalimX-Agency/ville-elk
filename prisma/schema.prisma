// Villa Elk — content the owner edits from the dashboard.
// Every visitor-facing string is stored once per language, so a single row
// serves the French, English, Spanish and Arabic pages.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A person who can sign in to the dashboard. The villa has one owner today,
/// so there is no invitation flow yet — accounts are created by script.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  OWNER
  EDITOR
}

/// One line of the "Prestations" section: a name in four languages and,
/// optionally, the photograph shown when a visitor hovers it.
model Amenity {
  id        String  @id @default(cuid())
  /// Stable handle used in code and URLs — never shown to visitors.
  slug      String  @unique
  position  Int
  published Boolean @default(true)

  nameFr String
  nameEn String
  nameEs String
  nameAr String

  /// Empty until a photograph exists for this amenity.
  imageUrl String?
  altFr    String?
  altEn    String?
  altEs    String?
  altAr    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

/// A request to stay, sent from the booking page. Nothing is charged and no
/// date is held: the owner answers each one personally.
model Enquiry {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  status    EnquiryStatus @default(NEW)

  name    String
  email   String
  phone   String?
  /// The language the visitor was reading, so the owner replies in it.
  locale  String
  message String?

  arrival   DateTime @db.Date
  departure DateTime @db.Date
  guests    Int

  /// When the owner's notification email went out; null means it never did.
  notifiedAt DateTime?

  /// Where it came from: "site" (the booking form) or "manual" (added by the
  /// owner for a stay arranged by phone or WhatsApp).
  source String @default("site")
  /// The owner's private notes; never shown to the guest.
  notes String @default("")
  /// When the status last changed, for "confirmée le …".
  statusChangedAt DateTime?

  /// The booking sheet ("fiche de réservation") sent on confirmation.
  /// Price agreed for the stay, before the tourist tax; null until set.
  priceDh      Int?
  /// Deposit already received.
  depositDh    Int?
  checkInTime  String    @default("15:00")
  checkOutTime String    @default("11:00")
  /// A line from the team printed on the sheet, in the guest's language.
  ficheNote    String    @default("")
  /// The language of the sheet; the guest's own by default.
  ficheLocale  String?
  /// Unguessable key of the guest's own link to the sheet.
  ficheToken   String?   @unique
  ficheSentAt  DateTime?

  @@index([status, createdAt])
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONFIRMED
  CANCELLED
}

/// A room the owner lets. Three suites upstairs and one bedroom on the ground
/// floor today; the photographs are placeholders until the shoot lands, which
/// is why the image is a field the dashboard owns rather than a file in the repo.
model Suite {
  id        String  @id @default(cuid())
  slug      String  @unique
  position  Int
  published Boolean @default(true)

  /// Which floor it sits on, matching the levels tour: "0" or "+1".
  level String

  nameFr String
  nameEn String
  nameEs String
  nameAr String

  descriptionFr String
  descriptionEn String
  descriptionEs String
  descriptionAr String

  /// Floor area in square metres, when the owner has measured it.
  areaSqm Int?

  /// What the room has, one item per line in the dashboard.
  featuresFr String[] @default([])
  featuresEn String[] @default([])
  featuresEs String[] @default([])
  featuresAr String[] @default([])

  /// Gallery photographs that show this room; its own page lists them.
  photos GalleryImage[]

  imageUrl String?
  altFr    String?
  altEn    String?
  altEs    String?
  altAr    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

/// One photograph in the gallery. No caption: the alt text carries the meaning
/// for search engines and screen readers, and the page shows the picture alone.
model GalleryImage {
  id        String  @id @default(cuid())
  position  Int
  published Boolean @default(true)

  /// Which part of the house the photograph shows; the gallery filters on it.
  /// One of: exterieur, rdc, sous-sol, suites, rooftop.
  category String @default("rdc")

  /// The suite it shows, if any. Deleting a suite leaves the photograph.
  suiteId String?
  suite   Suite?  @relation(fields: [suiteId], references: [id], onDelete: SetNull)

  /// Which part of the suite it shows, for the suite page's sections.
  /// One of: bedroom, desk, bathroom, balcony, details; null = unclassified.
  suiteSpace String?

  imageUrl String
  altFr    String
  altEn    String
  altEs    String
  altAr    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([category, position])
  @@index([suiteId, position])
}

/// A change to one piece of the site's copy, in one language. Only changes are
/// stored: a key with no row shows the text written in the code, so removing a
/// row restores the original.
model SiteText {
  locale    String
  /// Dot path into the dictionary, e.g. "hero.subtitle" or "tour.levels.0.body".
  key       String
  /// A string, or a list of strings for fields shown as lists.
  value     Json
  updatedAt DateTime @updatedAt

  @@id([locale, key])
}

/// One site-wide setting: contact details and the photographs the pages use
/// outside the gallery. A missing key falls back to the default in the code.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// A period the villa is closed to bookings: a stay arranged elsewhere, works,
/// the owner's own use. Blocks the same nights a confirmed stay would, and
/// the public calendar shows them the same way — the reason stays private.
model Closure {
  id        String   @id @default(cuid())
  /// First night closed.
  startDate DateTime @db.Date
  /// The morning it reopens: nights run up to, not including, this day.
  endDate   DateTime @db.Date
  /// One of: reservation, travaux, proprietaire, autre.
  reason    String   @default("autre")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}
