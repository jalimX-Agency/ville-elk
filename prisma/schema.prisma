// Villa Elk — content the owner edits from the dashboard.
// Every visitor-facing string is stored once per language, so a single row
// serves the French, English, Spanish and Arabic pages.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A person who can sign in to the dashboard. The villa has one owner today,
/// so there is no invitation flow yet — accounts are created by script.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum Role {
  OWNER
  EDITOR
}

/// One line of the "Prestations" section: a name in four languages and,
/// optionally, the photograph shown when a visitor hovers it.
model Amenity {
  id        String  @id @default(cuid())
  /// Stable handle used in code and URLs — never shown to visitors.
  slug      String  @unique
  position  Int
  published Boolean @default(true)

  nameFr String
  nameEn String
  nameEs String
  nameAr String

  /// Empty until a photograph exists for this amenity.
  imageUrl String?
  altFr    String?
  altEn    String?
  altEs    String?
  altAr    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

/// A request to stay, sent from the booking page. Nothing is charged and no
/// date is held: the owner answers each one personally.
model Enquiry {
  id        String        @id @default(cuid())
  createdAt DateTime      @default(now())
  status    EnquiryStatus @default(NEW)

  name    String
  email   String
  phone   String?
  /// The language the visitor was reading, so the owner replies in it.
  locale  String
  message String?

  arrival   DateTime @db.Date
  departure DateTime @db.Date
  guests    Int

  /// When the owner's notification email went out; null means it never did.
  notifiedAt DateTime?

  @@index([status, createdAt])
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONFIRMED
  CANCELLED
}

/// A room the owner lets. Three suites upstairs and one bedroom on the ground
/// floor today; the photographs are placeholders until the shoot lands, which
/// is why the image is a field the dashboard owns rather than a file in the repo.
model Suite {
  id        String  @id @default(cuid())
  slug      String  @unique
  position  Int
  published Boolean @default(true)

  /// Which floor it sits on, matching the levels tour: "0" or "+1".
  level String

  nameFr String
  nameEn String
  nameEs String
  nameAr String

  descriptionFr String
  descriptionEn String
  descriptionEs String
  descriptionAr String

  /// Floor area in square metres, when the owner has measured it.
  areaSqm Int?

  imageUrl String?
  altFr    String?
  altEn    String?
  altEs    String?
  altAr    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

/// One photograph in the gallery. No caption: the alt text carries the meaning
/// for search engines and screen readers, and the page shows the picture alone.
model GalleryImage {
  id        String  @id @default(cuid())
  position  Int
  published Boolean @default(true)

  imageUrl String
  altFr    String
  altEn    String
  altEs    String
  altAr    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}
